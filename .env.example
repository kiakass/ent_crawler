# ─────────────────────────────────────────────────────────────
# 기업정보크롤러 — 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 각 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 되어 있으며 절대 커밋하지 않습니다.
# ─────────────────────────────────────────────────────────────

# 공공데이터포털(data.go.kr) — 국세청 사업자등록정보 진위확인/상태조회
# 발급: data.go.kr 가입 → "국세청_사업자등록정보 진위확인 및 상태조회 서비스"
#       검색 → 활용신청(자동승인) → 마이페이지에서 인증키 확인
# 포털의 "일반 인증키(Encoding)" 값을 그대로 붙여넣으세요.
ODCLOUD_SERVICE_KEY=

# NAVER CLOUD PLATFORM — API Gateway 키
# 발급: console.ncloud.com → API Gateway / Maps 이용 신청 → Application 등록
NCP_APIGW_KEY_ID=
NCP_APIGW_KEY=

# (선택) 사내 TLS 프록시 환경에서 쓸 CA 번들 경로.
# 비워두면 certs/ca-bundle.pem → certifi 순으로 자동 사용.
CA_BUNDLE=

# 크롤링 요청의 From 헤더 — 운영 공용 메일
CRAWLER_CONTACT=

# 행정안전부 도로명주소 검색 API 승인키
JUSO_CONFM_KEY=
